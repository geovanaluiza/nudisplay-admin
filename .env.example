# Supabase (set real values locally; do not commit secrets)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Basic Auth for the admin panel — set these in Vercel (Production + Preview).
# Never prefix these with VITE_ or they will ship in the browser bundle.
# ADMIN_USER=
# ADMIN_PASSWORD=
